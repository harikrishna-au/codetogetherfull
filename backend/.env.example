# =============================================================================
# CodeTogether Arena — Backend Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Validation schema lives in `backend/src/config/env.ts`.
# =============================================================================

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Supabase (required) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Service role key — bypasses RLS, keep server-side only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Clerk (required) ----
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- JWT (optional / internal) ----
# Must be at least 32 characters if set
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ---- Timeouts (minutes) ----
SESSION_TIMEOUT_MINUTES=60
ROOM_TIMEOUT_MINUTES=90
QUEUE_TIMEOUT_MINUTES=10

# Grace period (seconds) before a disconnected player forfeits an active match
FORFEIT_GRACE_SECONDS=60

# ---- Code execution sandbox (A2) ----
# 'docker' (default, REQUIRED in production): submissions run in isolated
#   containers. Pre-pull the runtime images on the host:
#   docker pull node:20-alpine python:3.12-alpine eclipse-temurin:21-jdk-alpine gcc:13
# 'local' (dev only): spawns user code directly on this machine — UNSAFE.
EXECUTION_MODE=docker

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE=logs/app.log
